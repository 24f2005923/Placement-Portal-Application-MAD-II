# =================================================================
# .env.example - University Placement Portal
# =================================================================
# Copy this file to .env and adjust values as needed.
#   Windows  : copy .env.example .env
#   Mac/Linux: cp .env.example .env
# NEVER commit .env to version control.
# =================================================================

# -- Flask Core ---------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-long-random-jwt-string

# -- First-run database bootstrap --------------------------------
# Flask creates backend/database/placement.db and all tables automatically
# when backend/app.py starts. No demo students, companies, drives, exports,
# reports, or resumes are loaded from the repository.
#
# Keep SEED_ADMIN=true if you want one initial admin login on a fresh machine.
# Set SEED_ADMIN=false if you want a completely empty database.
SEED_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=password
DEFAULT_ADMIN_NAME=Portal Admin

# -- Redis (required for Celery background tasks and caching) -----
# Install Redis (Memurai on Windows, brew/apt on Mac/Linux).
# Leave these as-is for local development.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -- Email / MailHog (local SMTP, recommended for development) ----
#
# MailHog is a local SMTP trap included in this project (backend/MailHog.exe).
# It captures all outgoing emails without sending them to real addresses.
#
# Start MailHog before running the app:
#   Windows  : cd backend && .\MailHog.exe
#   Mac/Linux: download from https://github.com/mailhog/MailHog/releases
#
# View captured emails at: http://localhost:8025
#
# These settings route ALL application emails (interview reminders,
# status updates, drive deadline alerts, CSV export notifications, etc.)
# through MailHog automatically.
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=noreply@placement-portal.local

# -- Email / Production SMTP (uncomment to use real email) --------
# Replace the MailHog block above with these when deploying to production:
#
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-gmail-app-password
# MAIL_SENDER=noreply@your-domain.com

# -- Google Chat Webhook ------------------------------------------
# Leave blank to disable Google Chat notifications.
GCHAT_WEBHOOK_URL=

# -- SMS Provider -------------------------------------------------
# console prints SMS to the log, no account needed for development.
# Change to twilio and fill credentials to send real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
