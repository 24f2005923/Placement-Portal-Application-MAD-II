# ─────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in real values
# ─────────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────────
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-key

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Email (SMTP) ─────────────────────────────────────────────────
# Leave MAIL_USERNAME blank to use console (log) mode instead of real email.
# For local testing with MailHog, use:
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=false
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SENDER=noreply@placement-portal.local

# ── Google Chat Webhook ──────────────────────────────────────────
# Leave blank to disable Google Chat notifications.
GCHAT_WEBHOOK_URL=

# ── SMS Provider ─────────────────────────────────────────────────
# Options: console (default, no setup needed) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
